{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-src.mjs\"", "timeout": 20 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node build.mjs*)",
      "Bash(node tools/*)",
      "Bash(node tests/*)",
      "Bash(python3 tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git -c user.name=\"Sam Quinn\" *)",
      "Bash(git push*)"
    ]
  }
}
